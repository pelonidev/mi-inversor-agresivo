# ==========================================================
#  CREDENCIALES DEL EXCHANGE  (NUNCA subir el .env real a git)
# ==========================================================
# Copia este archivo a `.env` y rellena tus claves.
# Recomendado: usar claves API con permisos SOLO de trading (sin retiros).

EXCHANGE_ID=binance
EXCHANGE_API_KEY=tu_api_key_aqui
EXCHANGE_API_SECRET=tu_api_secret_aqui

# Sandbox / Testnet (true = papel, false = dinero real)
USE_TESTNET=true

# ==========================================================
#  PARÁMETROS DE RIESGO
# ==========================================================
ACCOUNT_EQUITY_USD=10000        # Capital inicial de referencia
MAX_DAILY_DRAWDOWN_PCT=0.01     # 1% -> dispara el Kill Switch
KELLY_FRACTION=0.25             # Fracción de Kelly (1/4 Kelly = conservador)
MAX_GROSS_EXPOSURE_PCT=2.0      # Exposición bruta máxima (200% del equity)
MAX_POSITION_PCT=0.10           # Tamaño máximo por posición (10% del equity)

# ==========================================================
#  LOGGING
# ==========================================================
LOG_LEVEL=INFO

# ==========================================================
#  DAEMON / FUNDING ARBITRAGE
# ==========================================================
TELEGRAM_BOT_TOKEN=          # token del bot (@BotFather)
TELEGRAM_CHAT_ID=            # chat/canal destino de las alertas
AUTO_TRADE=false            # true = ejecuta automáticamente las señales EXECUTABLE
CARRY_NOTIONAL_USD=1000     # tamaño por pata de la posición cash-and-carry
